# Αντιγράψτε αυτό το αρχείο σε .env.local για local ανάπτυξη
# Στο Vercel βάλτε τα παρακάτω ως Environment Variables

# Απαραίτητο: το OpenAI API key σας
OPENAI_API_KEY=sk-...

# Προαιρετικό: αλλάξτε μοντέλο αν θέλετε (default: gpt-4o-mini)
# Επιλογές: gpt-4o-mini | gpt-4o | gpt-4-turbo
OPENAI_MODEL=gpt-4o-mini
